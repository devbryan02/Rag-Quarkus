        {
          "name": "Chat - rate limit excedido",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Dispara varias solicitudes previas para agotar el limite de 10/min antes",
                  "// de que corra el request principal (que debe recibir 429). Encadenadas por",
                  "// callback (no top-level await: el sandbox de Postman/Newman no lo soporta),",
                  "// pm.sendRequest hace que el pre-request script espere hasta que terminan.",
                  "const base = pm.variables.get(\"baseUrl\");",
                  "const key = pm.variables.get(\"apiKey\");",
                  "let remaining = 10;",
                  "",
                  "function warmupOnce(done) {",
                  "    if (remaining <= 0) {",
                  "        done();",
                  "        return;",
                  "    }",
                  "    remaining--;",
                  "    pm.sendRequest({",
                  "        url: base + \"/chat\",",
                  "        method: \"POST\",",
                  "        header: {",
                  "            \"Content-Type\": \"application/json\",",
                  "            \"X-API-Key\": key",
                  "        },",
                  "        body: {",
                  "            mode: \"raw\",",
                  "            raw: JSON.stringify({ question: \"warmup\" })",
                  "        }",
                  "    }, function () { warmupOnce(done); });",
                  "}",
                  "",
                  "warmupOnce(function () {});"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 429\", function () {",
                  "    pm.response.to.have.status(429);",
                  "});",
                  "pm.test(\"Body es ErrorResponse de rate limit\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.success).to.eql(false);",
                  "    pm.expect(json.status).to.eql(429);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-API-Key", "value": "{{apiKey}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"question\": \"deberia rebotar por rate limit\"}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/chat",
              "host": ["{{baseUrl}}"],
              "path": ["chat"]
            }
          },
          "response": []
        }
