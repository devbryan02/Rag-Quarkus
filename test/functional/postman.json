                  "const CRLF = \"\\r\\n\";",
                  "const filename = \"postman-happy-\" + Date.now() + \".txt\";",
                  "pm.collectionVariables.set(\"lastHappyFilename\", filename);",
                  "",
                  "const body =",
                  "    \"--\" + boundary + CRLF +",
                  "    'Content-Disposition: form-data; name=\"file\"; filename=\"' + filename + '\"' + CRLF +",
                  "    \"Content-Type: text/plain\" + CRLF + CRLF +",
                  "    \"Contenido de prueba para RAG generado desde Postman/Bruno.\" + CRLF +",
                  "    \"--\" + boundary + \"--\" + CRLF;",
                  "",
                  "pm.request.body.mode = \"raw\";",
                  "pm.request.body.raw = body;",
                  "pm.request.headers.upsert({ key: \"Content-Type\", value: \"multipart/form-data; boundary=\" + boundary });"
